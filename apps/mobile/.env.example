EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# RevenueCat SDK keys are public app identifiers, not secret API keys. Leave
# blank until the Test Store/sandbox project exists; billing stays disabled.
# Test Store is development-only and is ignored by release builds.
EXPO_PUBLIC_REVENUECAT_TEST_STORE_API_KEY=
# Add the platform-specific public keys only when Apple and Google production
# app configurations exist. Never put a Test Store key in these slots.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
