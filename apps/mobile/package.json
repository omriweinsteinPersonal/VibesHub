{
  "name": "@vibeshub/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "build": "expo export --platform web",
    "clean": "rm -rf .expo dist",
    "dev": "expo start",
    "dev:client": "expo start --dev-client",
    "eas-build-post-install": "pnpm --filter @vibeshub/contracts build && pnpm --filter @vibeshub/design-tokens build && pnpm validate:build-env",
    "ios": "expo run:ios",
    "lint": "eslint . --max-warnings=0",
    "start": "expo start",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "validate:build-env": "node scripts/validate-build-env.mjs",
    "web": "expo start --web"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.2",
    "@vibeshub/contracts": "workspace:*",
    "@vibeshub/design-tokens": "workspace:*",
    "expo": "~57.0.27",
    "expo-apple-authentication": "~57.0.2",
    "expo-auth-session": "~57.0.14",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "10.10.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "eslint-config-expo": "57.0.2"
  }
}
