{
  "expo": {
    "name": "swavii",
    "slug": "swavii",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "swavii",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.swavii.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.swavii.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
