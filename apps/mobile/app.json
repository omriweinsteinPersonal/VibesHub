{
  "expo": {
    "name": "Swavii",
    "slug": "swavii",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "swavii",
    "userInterfaceStyle": "light",
    "ios": {
      "buildNumber": "1",
      "bundleIdentifier": "com.swavii.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "supportsTablet": false
    },
    "android": {
      "package": "com.swavii.app",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9dd2ddfe-6b1a-4076-8979-c9a72bc49c83"
      }
    },
    "owner": "swavii"
  }
}
