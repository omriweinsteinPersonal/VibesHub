{
  "expo": {
    "name": "Swavii",
    "slug": "swavii",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "swavii",
    "userInterfaceStyle": "light",
    "ios": {
      "associatedDomains": ["applinks:swavii.com", "applinks:www.swavii.com"],
      "bundleIdentifier": "com.swavii.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "supportsTablet": false
    },
    "android": {
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            { "scheme": "https", "host": "swavii.com", "pathPrefix": "/" },
            { "scheme": "https", "host": "www.swavii.com", "pathPrefix": "/" }
          ]
        }
      ],
      "package": "com.swavii.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9dd2ddfe-6b1a-4076-8979-c9a72bc49c83"
      }
    },
    "owner": "swavii"
  }
}
