HOST=0.0.0.0
PORT=4000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
DATABASE_POOL_MAX=2
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Server-only Sign in with Apple credentials used to revoke authorization when
# an Apple user deletes their account. Keep the private key out of EXPO_PUBLIC_*.
APPLE_CLIENT_ID=com.swavii.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Leave these blank until the RevenueCat sandbox webhook is created. Configure
# both together; secrets belong only in the API environment.
REVENUECAT_ALLOWED_ENVIRONMENT=sandbox
REVENUECAT_ENTITLEMENT_ID=creator_pro
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
